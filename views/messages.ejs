<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/create-message">Create Message</a>

        <% for(let oneMessage of Message){ %>
    <fieldset>
    <p>Message: <b><%= oneMessage.messageName %> </b></p>
    <p>Created by <%= oneMessage.messageName %> at <%= oneMessage.createdAt %></p>
    <a href="/channels/message=<%= oneMessage.messageID %>">Open Message</a>
    </fieldset>
    <% } %>
</body>
</html>