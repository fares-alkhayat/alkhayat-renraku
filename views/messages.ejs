<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/create-message">Create Message</a>

        <% for(let oneMessage of Message){ %>
    <fieldset>
    <p>Message <b><%= oneMessage.messageTitle %> </p>
    <p>Created by <%= oneMessage.messageOwner %> at <%= oneMessage.createdAt %> | ID: <%= oneMessage.messageID %>
    <a href="/channels/message=<%= oneMessage.messageID %>/edit">Edit/Delete Message</a>
    </fieldset>
    <% } %>
</body>
</html>