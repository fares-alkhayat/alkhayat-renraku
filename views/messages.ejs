<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/create-message">Create Message</a>

        <% for(let oneMessage of Message){ %>
    <fieldset>
    <p>Message <b><%= oneMessage.messageTitle %> </p>
    <p>Created by <%= oneMessage.messageOwner %> at <%= oneMessage.createdAt %> | ID: <%= oneMessage.messageID %>
    <br>
    <p><%= oneMessage.messageBody %></p>
    <br>

    <p><%= Message.upvoteCount.length %> upvotes</p>
    <form action="/channels/subchannel:=subchannelID/discussion=:discussionID/message=<%= messageID %>/upvoted-by/<%= userID %>" method="POST">
    <button type="submit">Upvote</button>
    <p><%= Message.downvoteCount.length %> downvotes</p>
    <form action="/channels/subchannel:=subchannelID/discussion=:discussionID/message=<%= MessageID %>/downvoted-by/<%= userID %>" method="POST">
    <button type="submit">Downvote</button>

    <% if (userHasUpvoted) { %>
<p>You've upvoted this message.</p>
<% } else if (userHasDownvoted) { %>
<p>You've downvoted this message.</p>
<% } %>
    <a href="/channels/message=<%= oneMessage.messageID %>/edit">Edit/Delete Message</a>
    </fieldset>
    <% } %>
</form>
</body>
</html>