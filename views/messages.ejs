<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/channels/subchannel/:subchannelID/discussion/:discussionID/create-message">Create Message</a>

        <% for(let oneMessage of Message){ %>
    <fieldset>
    <p>Message <b><%= oneMessage.messageTitle %></b></p>
    <p>Created by <%= oneMessage.messageOwner %> at <%= oneMessage.createdAt %> | ID: <%= oneMessage.messageID %>
    <br>
    <p><%= oneMessage.messageBody %></p>
    <br>
        <%= for(let oneUser of User){ %>
    <p><%= Message.upvoteCount %> upvotes</p>
    <form action="/channels/subchannel:=subchannelID/discussion/:discussionID/message/<%= Message.messageID %>/upvoted-by/<%= oneUser.userID %>" method="POST">
    <button type="submit">Upvote</button>
    <p><%= Message.downvoteCount %> downvotes</p>
    <form action="/channels/subchannel:=subchannelID/discussion/:discussionID/message/<%= Message.messageID %>/downvoted-by/<%= oneUser.userID %>" method="POST">
    <button type="submit">Downvote</button>
        <% } %>
    <% if (userHasUpvoted) { %>
<p>You've upvoted this message.</p>
<% } else if (userHasDownvoted) { %>
<p>You've downvoted this message.</p>
<% } %>
    <a href="/channels/subchannel:=subchannelID/discussion/:discussionID/message/<%= oneMessage.messageID %>/edit">Edit/Delete Message</a>
    </fieldset>
    <% } %>
</form>
</body>
</html>