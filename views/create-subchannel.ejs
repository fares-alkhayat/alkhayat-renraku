<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <h1>Create a Subchannel</h1>
        <form action="/create-subchannel" method="post">
        <label for="subchannelName">Subchannel Name:</label>
        <input type="text" name="subchannelName" id="subchannelName"/>
        <label for="subchannelName">Channel ID:</label>
        <input type="text" name="channelID" id="channelID"/>
        <p>Description:</p><textarea for="subchannelAbout" name="subchannelAbout" id="subchannelAbout" rows="25" cols="50"></textarea>
        <p>Rules:</p><textarea for="subchannelRules" name="subchannelRules" id="subchannelRules" rows="25" cols="50"></textarea>
        <button type="submit">Create Subchannel</button>
        </form>
</body>
</html>