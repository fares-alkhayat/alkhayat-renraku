<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/create-subchannel">Create Subchannel</a>

        <!-- <a href="/channels/<%= channelId %>/create-subchannel">Create Subchannel</a>
-->

    <% for(let oneSubchannel of Subchannel){ %>
    <fieldset>
    <p>Subchannel: <b><%= oneSubchannel.subchannelName %> </b></p>
    <p>Created by <%= oneSubchannel.subchannelOwner %> at <%= oneSubchannel.createdAt %></p>
    <a href="/channels/subchannel=<%= oneSubchannel.subchannelID %>">Open Subchannel</a>
    </fieldset>
    <% } %>
    
</body>
</html>