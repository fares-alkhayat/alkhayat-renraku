        <input type="text" name="messageTitle" id="messageTitle"/>
        <br>
        <p>Body Text:</p><textarea for="messageBody" name="messageBody" id="messageBody" rows="12" cols="70"></textarea>
        <button type="submit">Create Message</button>
        </form>

</body>
</html>