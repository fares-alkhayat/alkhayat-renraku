!<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
                <h1>Edit a Message</h1>

        <form action="/channels/subchannel=:subchannelID/discussion=:discussionID/message=<%= Message.messageID %>/edit?_method=PUT" method="post">
        <label for="subchannelName">Discussion Name:</label>
        <input type="text" name="discussionName" id="discussionName"/>
        <br><label for="subchannelID">Subchannel ID:</label>
        <input type="text" name="subchannelID" id="subchannelID"/>
        <p>Description:</p><textarea for="subchannelAbout" name="subchannelAbout" id="subchannelAbout" rows="12" cols="70"></textarea>
        <br>Genre:<input type="text" name="genre" id="genre"/>
        <br>Tags:<input type="text" name="tags" id="tags"/>
        <button type="submit">Edit Message</button>
        </form>

        <form action="/channels/subchannel=:subchannelID/discussion=:discussionID/message=<%= Message.messageID %>/edit?_method=DELETE" method="post">
        <button>Delete Message</button>
    </form>
</body>
</html>