<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/channels/subchannel/<%= subchannelId %>/create-discussion">Create Discussion</a>

        <% for(let oneDiscussion of Discussion){ %>
    <fieldset>
    <p>Discussion: <b><%= oneDiscussion.discussionName %> </b></p>
    <p>Created by <%= oneDiscussion.discussionOwner %> at <%= oneDiscussion.createdAt %></p>
    <a href="/channels/subchannel/<%= subchannelId %>/discussion/<%= oneDiscussion.discussionID %>">Open Discussion</a>
    <a href="/channels/subchannel/<%= subchannelId %>/discussion/<%= oneDiscussion.discussionID %>/edit">Edit/Delete Discussion</a>

        <p><%= Discussion.upvoteCount %> upvotes</p>
    <form action="/channels/subchannel/<%= subchannelId %>/discussion/<%= oneDiscussion.discussionID %>/upvote" method="POST">
    <button type="submit">Upvote</button>
    <p><%= Discussion.downvoteCount %> downvotes</p>
    <form action="/channels/subchannel/<%= subchannelId %>/discussion/<%= oneDiscussion.discussionID %>/downvoted-by/<%= user.userID %>" method="POST">
    <button type="submit">Downvote</button>

    <p><%= oneDiscussion.upvoteCount.length - oneDiscussion.downvoteCount.length %> Votes</p>

<!---
    <% // if (userHasUpvoted) { %>
<p>You've upvoted this discussion.</p>
<% // } else if (userHasDownvoted) { %>
<p>You've downvoted this discussion.</p>
<% // } %>
-->

    </fieldset>
    <% } %>
</body>
</html>