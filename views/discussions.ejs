<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>
        <a href="/create-discussion">Create Discussion</a>

        <% for(let oneDiscussion of Discussion){ %>
    <fieldset>
    <p>Discussion: <b><%= oneDiscussion.discussionName %> </b></p>
    <p>Created by <%= oneDiscussion.discussionOwner %> at <%= oneDiscussion.createdAt %></p>
    <a href="/channels/subchannel=:subchannelID/discussion=<%= oneDiscussion.discussionID %>">Open Discussion</a>
    <a href="/channels/subchannel=:subchannelID/discussion=<%= oneDiscussion.discussionID %>/edit">Edit/Delete Discussion</a>

    </fieldset>
    <% } %>
</body>
</html>