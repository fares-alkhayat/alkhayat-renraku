<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <%- include('./partials/navbar') %>

        <h1>Select a channel</h1>
            <% for(let oneChannel of Channel){ %>
    <fieldset>
    <p>Channel: <b><%= oneChannel.channelName %> </b></p>
    <p>Approved for release on <%= oneChannel.approvedAt %></p>
    <a href="/channels/<%= oneChannel.channelID %>">Open Channel</a>
    </fieldset>
    <% } %>
    
</body>
</html>